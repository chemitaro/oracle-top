{
  "name": "oracle-top",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "format:check": "prettier --check \"**/*.{ts,json,yml,yaml}\"",
    "check": "npm run format:check && npm run typecheck && npm run build && npm test",
    "perf": "node scripts/performance.mjs --measure .workbench/p10/perf-fixture .workbench/p10/perf-result.json",
    "smoke:cli": "npm run build && node scripts/smoke-cli.mjs",
    "smoke:tty": "python3 scripts/smoke-tty.py"
  },
  "dependencies": {
    "json5": "2.2.3",
    "string-width": "8.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "ajv": "8.20.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "bin": {
    "oracle-top": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
